# Copy to .env and fill in. .env is git-ignored: never commit real values.
#   cp .env.example .env

# --- Elasticsearch (https://ela.st/hack-kubecon, project type: Elasticsearch) ---
# Endpoint looks like https://<project>.es.<region>.<cloud>.elastic.cloud
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# --- Dash0 (Settings > Endpoints and Settings > Auth Tokens) ---
# OTLP over HTTP endpoint, looks like https://ingress.<region>.aws.dash0.com
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
# Optional: browser monitoring. Use a SEPARATE token limited to ingestion,
# because the browser can read it.
DASH0_RUM_TOKEN=

# --- Optional: grounded answers for "Ask" ($50 OpenAI credits from the event) ---
OPENAI_API_KEY=

# --- Shared secret for the practice-incident switch on deployed environments.
# Leave empty locally (the switch is open in local development);
# scripts/make-secret.sh generates one for the cluster.
OPS_TOKEN=

# --- Radar team name from join.cnh.radarhq.io (not a secret) ---
TEAM_NAME=
