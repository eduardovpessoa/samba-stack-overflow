{
  "name": "samba-stack-overflow",
  "version": "1.0.0",
  "private": true,
  "description": "Samba Stack Overflow: find your talk, find your people. Conference search on Elasticsearch.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --require ./src/otel.js server.js",
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --watch --require ./src/otel.js server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "express": "^5.3.0"
  }
}
